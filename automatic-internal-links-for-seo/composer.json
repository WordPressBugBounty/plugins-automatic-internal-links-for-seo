    "autoload": {
        "psr-4": {
            "Pagup\\AutoLinks\\": "admin/",
            "Pagup\\AutoLinks\\Core\\": "admin/core/",
            "Pagup\\AutoLinks\\Controllers\\": "admin/controllers/",
            "Pagup\\AutoLinks\\Traits\\": "admin/traits/",
            "Pagup\\AutoLinks\\Bootstrap\\": "bootstrap/"
        }
    },
    "require": {
        "php": ">=7.4",
        "friedolinfoerder/html-changer": "^0.1.6"
    },
    "scripts": {
        "pagup:patch-html-changer": "@php composer-patches/apply-html-changer-php83.php",
        "post-install-cmd": [
            "@pagup:patch-html-changer"
        ],
        "post-update-cmd": [
